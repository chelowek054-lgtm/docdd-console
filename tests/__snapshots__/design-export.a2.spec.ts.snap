"// css -> app/assets/css/main.css
/* docdd-design:start — Сгенерировано консолью DocDD из токенов дизайна v1.2.0 (docs/16-design-system.md). Не правьте руками: меняются токены. */
/* Размеры в rem: следуют за настройкой шрифта пользователя; корень не задаётся в px. */
html { font-size: 100%; }

/* Точки перелома Tailwind совпадают с сеткой, поэтому md: и ds-col-md-* срабатывают на одной ширине. */
@theme {
  --breakpoint-sm: 36rem;
  --breakpoint-md: 48rem;
  --breakpoint-lg: 62rem;
  --breakpoint-xl: 75rem;
  --breakpoint-xxl: 87.5rem;
}

:root {
  --ds-space-xs: 0.25rem;
  --ds-space-sm: 0.5rem;
  --ds-space-md: 1rem;
  --ds-space-lg: 1.5rem;
  --ds-space-xl: 2rem;
  --ds-space-xxl: 3rem;
  --ds-radius-sm: 0.25rem;
  --ds-radius-md: 0.5rem;
  --ds-radius-pill: 62.5rem;
  --ds-font-body: 1rem;
  --ds-line-body: 1.5rem;
  --ds-weight-body: 400;
  --ds-font-title: 1.5rem;
  --ds-line-title: 2rem;
  --ds-weight-title: 700;
  --ds-grid-columns: 12;
  --ds-grid-gutter: 1.5rem;
  --ds-bp-xs: 0rem;
  --ds-bp-sm: 36rem;
  --ds-bp-md: 48rem;
  --ds-bp-lg: 62rem;
  --ds-bp-xl: 75rem;
  --ds-bp-xxl: 87.5rem;
  --ds-measure: 70ch;
}

:root {
  color-scheme: light;
  --ds-color-bg: #FFFFFF;
  --ds-color-ink: #111111;
  --ds-color-accent: #2255CC;
  --ds-color-shadow: #000000;
  --ui-bg: #FFFFFF;
  --ui-text: #111111;
  --ui-text-highlighted: #111111;
  --ui-primary: #2255CC;
}

.dark {
  color-scheme: dark;
  --ds-color-bg: #101010;
  --ds-color-ink: #EEEEEE;
  --ds-color-accent: #88AAFF;
  --ds-color-shadow: #000000;
  --ui-bg: #101010;
  --ui-text: #EEEEEE;
  --ui-text-highlighted: #EEEEEE;
  --ui-primary: #88AAFF;
}

.ds-container {
  width: 100%;
  margin-inline: auto;
  padding-inline: calc(var(--ds-grid-gutter) / 2);
}
.ds-row {
  display: flex;
  flex-wrap: wrap;
  margin-inline: calc(var(--ds-grid-gutter) / -2);
}
.ds-row > * {
  box-sizing: border-box;
  flex-shrink: 0;
  width: 100%;
  max-width: 100%;
  padding-inline: calc(var(--ds-grid-gutter) / 2);
}
.ds-col { flex: 1 0 0%; }
.ds-col-auto { flex: 0 0 auto; width: auto; }
.ds-col-1 { flex: 0 0 auto; width: 8.333333%; }
.ds-col-2 { flex: 0 0 auto; width: 16.666667%; }
.ds-col-3 { flex: 0 0 auto; width: 25%; }
