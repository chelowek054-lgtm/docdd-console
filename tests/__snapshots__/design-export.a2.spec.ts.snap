"// color -> Color.kt
// Сгенерировано консолью DocDD из токенов дизайна v1.2.0 (docs/16-design-system.md). Не правьте руками: меняются токены.
package ui.theme

import androidx.compose.material3.ColorScheme
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.ui.graphics.Color

val LightBg = Color(0xFFFFFFFF)
val LightInk = Color(0xFF111111)
val LightAccent = Color(0xFF2255CC)
val LightShadow = Color(0xFF000000)

val DarkBg = Color(0xFF101010)
val DarkInk = Color(0xFFEEEEEE)
val DarkAccent = Color(0xFF88AAFF)
val DarkShadow = Color(0xFF000000)

val LightColorScheme: ColorScheme = lightColorScheme(
    background = LightBg,
    onBackground = LightInk,
    onSurface = LightInk,
    primary = LightAccent,
)

val DarkColorScheme: ColorScheme = darkColorScheme(
    background = DarkBg,
    onBackground = DarkInk,
    onSurface = DarkInk,
    primary = DarkAccent,
)

/** Роли, которых нет в Material 3: смысловой цвет ядра и состояния. */
data class AppExtraColors(val core: Color, val ok: Color, val warn: Color)

val LightExtraColors = AppExtraColors()
val DarkExtraColors = AppExtraColors()

// type -> Type.kt
// Сгенерировано консолью DocDD из токенов дизайна v1.2.0 (docs/16-design-system.md). Не правьте руками: меняются токены.
// Размеры — rem × 16; sp следует за масштабом шрифта системы.
package ui.theme

import androidx.compose.material3.Typography
import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.sp

val AppTypography = Typography(
    bodyMedium = TextStyle(fontSize = 16.sp, lineHeight = 24.sp, fontWeight = FontWeight.W400),
    titleLarge = TextStyle(fontSize = 24.sp, lineHeight = 32.sp, fontWeight = FontWeight.W700),
)

// shape -> Shape.kt
// Сгенерировано консолью DocDD из токенов дизайна v1.2.0 (docs/16-design-system.md). Не правьте руками: меняются токены.
package ui.theme

import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.Shapes
import androidx.compose.ui.unit.dp

val AppShapes = Shapes(
    small = RoundedCornerShape(4.dp),
    medium = RoundedCornerShape(8.dp),
    large = RoundedCornerShape(8.dp),
)

/** Плашка: полностью скруглённая. */
val PillShape = RoundedCornerShape(1000.dp)

// theme -> Theme.kt
// Сгенерировано консолью DocDD из токенов дизайна v1.2.0 (docs/16-design-system.md). Не правьте руками: меняются токены.
package ui.theme

import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.staticCompositionLocalOf
import androidx.compose.ui.unit.dp

/** Темы продукта: светлая и тёмная — база, остальные поверх. */
enum class AppThemeName { Light, Dark }

val LocalExtraColors = staticCompositionLocalOf { LightExtraColors }

object AppSpacing {
    val xs = 4.dp
    val sm = 8.dp
    val md = 16.dp
    val lg = 24.dp
    val xl = 32.dp
    val xxl = 48.dp
}

object AppBorder {
}

object AppIcon {
}

/** Длительности, мс; при «убрать анимации» в системе компонент обязан их обнулить. */
object AppMotion {
}

object AppFonts {
    const val measure = 70
}

/** Сетка: колонки, поле и точки перелома в dp (rem × root). */
object AppGrid {
    const val columns = 12
    val gutter = 24.dp
    val breakpoints = mapOf("xs" to 0.dp, "sm" to 576.dp, "md" to 768.dp, "lg" to 992.dp, "xl" to 1200.dp, "xxl" to 1400.dp)
    val containers = mapOf("sm" to 540.dp, "md" to 720.dp, "lg" to 960.dp, "xl" to 1140.dp, "xxl" to 1320.dp)
}

/** Языки продукта: точка подключения словарей. */
object AppLocales {
    const val default = "ru"
    const val fallback = "en"
    val all = listOf("ru", "en")
}

@Composable
fun AppTheme(
    theme: AppThemeName? = null,
    darkTheme: Boolean = isSystemInDarkTheme(),
    content: @Composable () -> Unit,
) {
    val chosen = theme ?: if (darkTheme) AppThemeName.Dark else AppThemeName.Light
    val scheme = when (chosen) {
        AppThemeName.Light -> LightColorScheme
        AppThemeName.Dark -> DarkColorScheme
    }
    val extra = when (chosen) {
        AppThemeName.Light -> LightExtraColors
        AppThemeName.Dark -> DarkExtraColors
    }
    CompositionLocalProvider(LocalExtraColors provides extra) {
        MaterialTheme(
            colorScheme = scheme,
            typography = AppTypography,
            shapes = AppShapes,
            content = content,
        )
    }
}
"
`;

exports[`выгрузка токенов в стеки > expo: снимок и повторный запуск дают один и тот же текст 1`] = `
"// theme -> constants/theme.ts
// Сгенерировано консолью DocDD из токенов дизайна v1.2.0 (docs/16-design-system.md). Не правьте руками: меняются токены.
// Размеры — rem × 16: у React Native нет rem, а масштаб шрифта системы остаётся включённым.
import { useColorScheme } from 'react-native';

export const LightColors = {
  bg: '#FFFFFF',
  ink: '#111111',
  accent: '#2255CC',
  shadow: '#000000',
} as const;

export const DarkColors = {
  bg: '#101010',
  ink: '#EEEEEE',
  accent: '#88AAFF',
  shadow: '#000000',
} as const;

/** Роли без привязки к значениям темы: иначе тёмная палитра не присваивается типу светлой. */
export type ThemeColors = { -readonly [K in keyof typeof LightColors]: string };

export const Themes = {
  light: LightColors,
  dark: DarkColors,
} as const;

export type ThemeName = keyof typeof Themes;

export const spacing = {
  xs: 4,
  sm: 8,
  md: 16,
  lg: 24,
  xl: 32,
  xxl: 48,
} as const;

export const radius = {
  sm: 4,
  md: 8,
  pill: 1000,
} as const;

export const border = {
} as const;

export const icon = {
} as const;

/** Длительности, мс; при «уменьшить движение» в системе компонент обязан их обнулить. */
export const motion = {
} as const;

export const fonts = {
} as const;

/** Длина строки в символах: ограничивайте ширину текстового блока. */
export const measure = 70;

export const typography = {
  body: { fontSize: 16, lineHeight: 24, fontWeight: '400' },
  title: { fontSize: 24, lineHeight: 32, fontWeight: '700' },
} as const;

export const grid = {
  columns: 12,
  gutter: 24,
  breakpoints: {
    xs: 0,
    sm: 576,
    md: 768,
    lg: 992,
    xl: 1200,
    xxl: 1400,
  },
  containers: {
    sm: 540,
    md: 720,
    lg: 960,
    xl: 1140,
    xxl: 1320,
  },
} as const;

/** Точка сетки для ширины экрана в dp: наибольшая из тех, что не больше ширины. */
export function breakpointFor(width: number): keyof typeof grid.breakpoints {
  const names = Object.keys(grid.breakpoints) as (keyof typeof grid.breakpoints)[];
  return names.filter((name) => grid.breakpoints[name] <= width).pop() ?? names[0]!;
}

export const i18n = {
  default: 'ru',
  fallback: 'en',
  locales: ['ru', 'en'],
} as const;

/** Палитра по имени темы; без имени — по системной теме, \`null\` из \`useColorScheme()\` — светлая. */
export function useThemeColors(name?: ThemeName): ThemeColors {
  const scheme = useColorScheme();
  return Themes[name ?? (scheme === 'dark' ? 'dark' : 'light')];
}
"
`;

