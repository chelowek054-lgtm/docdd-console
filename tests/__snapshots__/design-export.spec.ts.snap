  .ds-col-xl-2 { flex: 0 0 auto; width: 16.666667%; }
  .ds-col-xl-3 { flex: 0 0 auto; width: 25%; }
  .ds-col-xl-4 { flex: 0 0 auto; width: 33.333333%; }
  .ds-col-xl-5 { flex: 0 0 auto; width: 41.666667%; }
  .ds-col-xl-6 { flex: 0 0 auto; width: 50%; }
  .ds-col-xl-7 { flex: 0 0 auto; width: 58.333333%; }
  .ds-col-xl-8 { flex: 0 0 auto; width: 66.666667%; }
  .ds-col-xl-9 { flex: 0 0 auto; width: 75%; }
  .ds-col-xl-10 { flex: 0 0 auto; width: 83.333333%; }
  .ds-col-xl-11 { flex: 0 0 auto; width: 91.666667%; }
  .ds-col-xl-12 { flex: 0 0 auto; width: 100%; }
}
@media (min-width: 87.5rem) {
  .ds-container { max-width: 82.5rem; }
  .ds-col-xxl { flex: 1 0 0%; }
  .ds-col-xxl-auto { flex: 0 0 auto; width: auto; }
  .ds-col-xxl-1 { flex: 0 0 auto; width: 8.333333%; }
  .ds-col-xxl-2 { flex: 0 0 auto; width: 16.666667%; }
  .ds-col-xxl-3 { flex: 0 0 auto; width: 25%; }
  .ds-col-xxl-4 { flex: 0 0 auto; width: 33.333333%; }
  .ds-col-xxl-5 { flex: 0 0 auto; width: 41.666667%; }
  .ds-col-xxl-6 { flex: 0 0 auto; width: 50%; }
  .ds-col-xxl-7 { flex: 0 0 auto; width: 58.333333%; }
  .ds-col-xxl-8 { flex: 0 0 auto; width: 66.666667%; }
  .ds-col-xxl-9 { flex: 0 0 auto; width: 75%; }
  .ds-col-xxl-10 { flex: 0 0 auto; width: 83.333333%; }
  .ds-col-xxl-11 { flex: 0 0 auto; width: 91.666667%; }
  .ds-col-xxl-12 { flex: 0 0 auto; width: 100%; }
}

/* Видимый фокус: условие работы с клавиатуры (WCAG 2.1 AA). */
:focus-visible {
  outline: var(--ds-border-thick, 0.125rem) solid var(--ds-color-focus, currentColor);
  outline-offset: 0.125rem;
}

/* Тем, кому движение вредит, оно отключается само. */
@media (prefers-reduced-motion: reduce) {
  :root {
    --ds-motion-fast: 0ms;
    --ds-motion-base: 0ms;
    --ds-motion-slow: 0ms;
  }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* Версия для печати: светлая и на всю ширину. */
@media print {
  :root { color-scheme: light; }
  .ds-container { max-width: none; }
}
/* docdd-design:end */

