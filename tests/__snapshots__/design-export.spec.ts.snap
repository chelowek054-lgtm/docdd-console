exports[`выгрузка в стеки > swiftui: снимок и тот же текст при повторе 1`] = `
"// theme Theme.swift
// Сгенерировано консолью DocDD из токенов дизайна v1.8.0 (docs/16-design-system.md). Не правьте руками: меняются токены.
// Размеры — rem × 16; у SwiftUI нет rem, а Dynamic Type остаётся включённым.
import SwiftUI

extension SwiftUI.Color {
    /// Цвет из 0xAARRGGBB: для тем, которых нет в каталоге ассетов.
    init(argb: UInt32) {
        self.init(
            .sRGB,
            red: Double((argb >> 16) & 0xFF) / 255,
            green: Double((argb >> 8) & 0xFF) / 255,
            blue: Double(argb & 0xFF) / 255,
            opacity: Double((argb >> 24) & 0xFF) / 255
        )
    }
}

/// Цвета светлой и тёмной тем берутся из каталога ассетов: у каждой роли варианты Any и Dark.
enum AppTheme {
    enum Colors {
        static let bg = SwiftUI.Color("bg")
        static let surface = SwiftUI.Color("surface")
        static let surfaceAlt = SwiftUI.Color("surfaceAlt")
        static let ink = SwiftUI.Color("ink")
        static let muted = SwiftUI.Color("muted")
        static let line = SwiftUI.Color("line")
        static let accent = SwiftUI.Color("accent")
        static let accentText = SwiftUI.Color("accentText")
        static let onAccent = SwiftUI.Color("onAccent")
        static let core = SwiftUI.Color("core")
        static let ok = SwiftUI.Color("ok")
        static let info = SwiftUI.Color("info")
        static let warn = SwiftUI.Color("warn")
        static let danger = SwiftUI.Color("danger")
        static let onDanger = SwiftUI.Color("onDanger")
        static let focus = SwiftUI.Color("focus")
    }

    /// Тема «High contrast»: база dark, цвета в коде, а не в каталоге ассетов.
    enum Contrast {
        static let bg = SwiftUI.Color(argb: 0xFF000000)
        static let surface = SwiftUI.Color(argb: 0xFF0A0A0A)
        static let surfaceAlt = SwiftUI.Color(argb: 0xFF1A1A1A)
        static let ink = SwiftUI.Color(argb: 0xFFFFFFFF)
        static let muted = SwiftUI.Color(argb: 0xFFE0E0E0)
        static let line = SwiftUI.Color(argb: 0xFFFFFFFF)
        static let accent = SwiftUI.Color(argb: 0xFFFFE600)
        static let accentText = SwiftUI.Color(argb: 0xFFFFE600)
        static let onAccent = SwiftUI.Color(argb: 0xFF000000)
        static let core = SwiftUI.Color(argb: 0xFFFFB000)
        static let ok = SwiftUI.Color(argb: 0xFF00FF7F)
        static let info = SwiftUI.Color(argb: 0xFF80D8FF)
        static let warn = SwiftUI.Color(argb: 0xFFFFD54F)
        static let danger = SwiftUI.Color(argb: 0xFFFF8A80)
        static let onDanger = SwiftUI.Color(argb: 0xFF000000)
        static let focus = SwiftUI.Color(argb: 0xFFFFE600)
    }

    /// Тема «OLED»: база dark, цвета в коде, а не в каталоге ассетов.
    enum Oled {
        static let bg = SwiftUI.Color(argb: 0xFF000000)
        static let surface = SwiftUI.Color(argb: 0xFF090B10)
        static let surfaceAlt = SwiftUI.Color(argb: 0xFF12151D)
        static let ink = SwiftUI.Color(argb: 0xFFE8EBF5)
        static let muted = SwiftUI.Color(argb: 0xFF9AA3BC)
        static let line = SwiftUI.Color(argb: 0xFF232838)
        static let accent = SwiftUI.Color(argb: 0xFF4ADE80)
        static let accentText = SwiftUI.Color(argb: 0xFF4ADE80)
        static let onAccent = SwiftUI.Color(argb: 0xFF04150B)
        static let core = SwiftUI.Color(argb: 0xFFA890F5)
        static let ok = SwiftUI.Color(argb: 0xFF4ADE80)
        static let info = SwiftUI.Color(argb: 0xFF6BA8F5)
        static let warn = SwiftUI.Color(argb: 0xFFF2C14E)
        static let danger = SwiftUI.Color(argb: 0xFFF08080)
        static let onDanger = SwiftUI.Color(argb: 0xFF2A0A07)
        static let focus = SwiftUI.Color(argb: 0xFF4ADE80)
    }

    enum Spacing {
        static let xs: CGFloat = 4
        static let sm: CGFloat = 8
        static let md: CGFloat = 12
        static let lg: CGFloat = 16
        static let xl: CGFloat = 24
        static let xxl: CGFloat = 32
    }

    enum Radius {
        static let sm: CGFloat = 8
        static let md: CGFloat = 12
        static let pill: CGFloat = 1000
    }

    enum Border {
        static let thin: CGFloat = 1
        static let thick: CGFloat = 2
    }

    enum Icon {
        static let sm: CGFloat = 16
        static let md: CGFloat = 20
        static let lg: CGFloat = 24
    }

    /// Длительности в секундах; при «уменьшить движение» компонент обязан их обнулить.
    enum Motion {
        static let fast: Double = 0.12
        static let base: Double = 0.2
        static let slow: Double = 0.32
    }

    enum Fonts {
        static let body = "system-ui, -apple-system, \\"Segoe UI\\", Roboto, \\"Helvetica Neue\\", Arial, sans-serif"
        static let mono = "ui-monospace, SFMono-Regular, Menlo, Consolas, \\"Liberation Mono\\", monospace"
        static let measure = 70
    }

    enum Typography {
        static let caption = Font.system(size: 12, weight: .regular)
        static let small = Font.system(size: 13, weight: .regular)
        static let body = Font.system(size: 15, weight: .regular)
        static let lead = Font.system(size: 17, weight: .medium)
        static let title = Font.system(size: 22, weight: .semibold)
        static let display = Font.system(size: 28, weight: .bold)
    }

    /// Сетка: колонки, поле и точки перелома.
    enum Grid {
        static let columns = 12
        static let gutter: CGFloat = 24
        static let breakpoints: [String: CGFloat] = [
            "xs": 0,
            "sm": 576,
            "md": 768,
            "lg": 992,
            "xl": 1200,
            "xxl": 1400
        ]
        static let containers: [String: CGFloat] = [
            "sm": 540,
            "md": 720,
            "lg": 960,
            "xl": 1140,
            "xxl": 1320
        ]
    }

    /// Языки продукта: точка подключения словарей.
    enum Locales {
        static let standard = "ru"
        static let fallback = "en"
        static let all = ["ru", "en"]
    }
}

