  --ds-color-line: #232838;
  --ds-color-accent: #4ADE80;
  --ds-color-accent-text: #4ADE80;
  --ds-color-on-accent: #04150B;
  --ds-color-core: #A890F5;
  --ds-color-ok: #4ADE80;
  --ds-color-info: #6BA8F5;
  --ds-color-warn: #F2C14E;
  --ds-color-danger: #F08080;
  --ds-color-on-danger: #2A0A07;
  --ds-color-focus: #4ADE80;
  --ui-bg: #000000;
  --ui-bg-elevated: #090B10;
  --ui-bg-muted: #12151D;
  --ui-bg-accented: #12151D;
  --ui-text: #E8EBF5;
  --ui-text-highlighted: #E8EBF5;
  --ui-text-muted: #9AA3BC;
  --ui-border: #232838;
  --ui-primary: #4ADE80;
  --ui-success: #4ADE80;
  --ui-info: #6BA8F5;
  --ui-warning: #F2C14E;
  --ui-error: #F08080;
}

/* Системная настройка «повысить контраст» включает палитру темы contrast. */
@media (prefers-contrast: more) {
  :root {
    color-scheme: dark;
    --ds-color-bg: #000000;
    --ds-color-surface: #0A0A0A;
    --ds-color-surface-alt: #1A1A1A;
    --ds-color-ink: #FFFFFF;
    --ds-color-muted: #E0E0E0;
    --ds-color-line: #FFFFFF;
    --ds-color-accent: #FFE600;
    --ds-color-accent-text: #FFE600;
    --ds-color-on-accent: #000000;
    --ds-color-core: #FFB000;
    --ds-color-ok: #00FF7F;
    --ds-color-info: #80D8FF;
    --ds-color-warn: #FFD54F;
    --ds-color-danger: #FF8A80;
    --ds-color-on-danger: #000000;
    --ds-color-focus: #FFE600;
    --ui-bg: #000000;
    --ui-bg-elevated: #0A0A0A;
    --ui-bg-muted: #1A1A1A;
    --ui-bg-accented: #1A1A1A;
    --ui-text: #FFFFFF;
    --ui-text-highlighted: #FFFFFF;
    --ui-text-muted: #E0E0E0;
    --ui-border: #FFFFFF;
    --ui-primary: #FFE600;
    --ui-success: #00FF7F;
    --ui-info: #80D8FF;
    --ui-warning: #FFD54F;
    --ui-error: #FF8A80;
  }
}

.ds-container {
  width: 100%;
  margin-inline: auto;
  padding-inline: calc(var(--ds-grid-gutter) / 2);
}
.ds-row {
  display: flex;
  flex-wrap: wrap;
  margin-inline: calc(var(--ds-grid-gutter) / -2);
}
.ds-row > * {
  box-sizing: border-box;
  flex-shrink: 0;
  width: 100%;
  max-width: 100%;
  padding-inline: calc(var(--ds-grid-gutter) / 2);
}
.ds-col { flex: 1 0 0%; }
.ds-col-auto { flex: 0 0 auto; width: auto; }
.ds-col-1 { flex: 0 0 auto; width: 8.333333%; }
.ds-col-2 { flex: 0 0 auto; width: 16.666667%; }
.ds-col-3 { flex: 0 0 auto; width: 25%; }
.ds-col-4 { flex: 0 0 auto; width: 33.333333%; }
.ds-col-5 { flex: 0 0 auto; width: 41.666667%; }
.ds-col-6 { flex: 0 0 auto; width: 50%; }
.ds-col-7 { flex: 0 0 auto; width: 58.333333%; }
.ds-col-8 { flex: 0 0 auto; width: 66.666667%; }
.ds-col-9 { flex: 0 0 auto; width: 75%; }
.ds-col-10 { flex: 0 0 auto; width: 83.333333%; }
.ds-col-11 { flex: 0 0 auto; width: 91.666667%; }
.ds-col-12 { flex: 0 0 auto; width: 100%; }
@media (min-width: 36rem) {
