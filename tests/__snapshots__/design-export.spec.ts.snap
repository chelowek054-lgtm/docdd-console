val OledOk = Color(0xFF4ADE80)
val OledInfo = Color(0xFF6BA8F5)
val OledWarn = Color(0xFFF2C14E)
val OledDanger = Color(0xFFF08080)
val OledOnDanger = Color(0xFF2A0A07)
val OledFocus = Color(0xFF4ADE80)

val LightColorScheme: ColorScheme = lightColorScheme(
    background = LightBg,
    onBackground = LightInk,
    surface = LightSurface,
    onSurface = LightInk,
    surfaceVariant = LightSurfaceAlt,
    onSurfaceVariant = LightMuted,
    outline = LightLine,
    primary = LightAccent,
    onPrimary = LightOnAccent,
    error = LightDanger,
    onError = LightOnDanger,
)

val DarkColorScheme: ColorScheme = darkColorScheme(
    background = DarkBg,
    onBackground = DarkInk,
    surface = DarkSurface,
    onSurface = DarkInk,
    surfaceVariant = DarkSurfaceAlt,
    onSurfaceVariant = DarkMuted,
    outline = DarkLine,
    primary = DarkAccent,
    onPrimary = DarkOnAccent,
    error = DarkDanger,
    onError = DarkOnDanger,
)

val ContrastColorScheme: ColorScheme = darkColorScheme(
    background = ContrastBg,
    onBackground = ContrastInk,
    surface = ContrastSurface,
    onSurface = ContrastInk,
    surfaceVariant = ContrastSurfaceAlt,
    onSurfaceVariant = ContrastMuted,
    outline = ContrastLine,
    primary = ContrastAccent,
    onPrimary = ContrastOnAccent,
    error = ContrastDanger,
    onError = ContrastOnDanger,
)

val OledColorScheme: ColorScheme = darkColorScheme(
    background = OledBg,
    onBackground = OledInk,
    surface = OledSurface,
    onSurface = OledInk,
    surfaceVariant = OledSurfaceAlt,
    onSurfaceVariant = OledMuted,
    outline = OledLine,
    primary = OledAccent,
    onPrimary = OledOnAccent,
    error = OledDanger,
    onError = OledOnDanger,
)

/** Роли, которых нет в Material 3: смысловой цвет ядра и состояния. */
data class AppExtraColors(val core: Color, val ok: Color, val warn: Color)

val LightExtraColors = AppExtraColors(accentText = LightAccentText, core = LightCore, ok = LightOk, info = LightInfo, warn = LightWarn)
val DarkExtraColors = AppExtraColors(accentText = DarkAccentText, core = DarkCore, ok = DarkOk, info = DarkInfo, warn = DarkWarn)
val ContrastExtraColors = AppExtraColors(accentText = ContrastAccentText, core = ContrastCore, ok = ContrastOk, info = ContrastInfo, warn = ContrastWarn)
val OledExtraColors = AppExtraColors(accentText = OledAccentText, core = OledCore, ok = OledOk, info = OledInfo, warn = OledWarn)

