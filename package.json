{
  "name": "docdd-console",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Documentation Driven Development, enforced: tasks can't start until a human approves the documents behind them",
  "license": "Apache-2.0",
  "author": "chelowek <chelowekapi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelowek054-lgtm/docdd-console.git"
  },
  "keywords": [
    "documentation-driven-development",
    "spec-driven-development",
    "ai-agents",
    "architecture",
    "requirements",
    "nuxt"
  ],
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start:built": "tsx cli/start-built.ts",
    "postinstall": "nuxt prepare",
    "check": "tsx cli/check.ts",
    "add-user": "tsx cli/add-user.ts",
    "perf": "tsx cli/perf.ts",
    "embeddings": "tsx cli/embeddings.ts",
    "mcp": "tsx cli/mcp.ts",
    "token-report": "tsx cli/token-report.ts",
    "typecheck": "tsc --noEmit && nuxt typecheck",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/ui": "^4.11.0",
    "@pinia/nuxt": "^1.0.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "elkjs": "0.12.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "markdown-it": "^15.0.1",
    "mermaid": "^11.17.2",
    "nuxt": "^4.4.5",
    "pinia": "^4.0.3",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.127",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
